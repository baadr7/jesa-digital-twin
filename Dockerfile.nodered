# JESA Digital Twin - Node-RED Gateway
#
# Base: nodered/node-red:4.0.9-20 (Node.js 20 LTS, Alpine)

FROM nodered/node-red:4.0.9-20

USER root

RUN apk add --no-cache openssl

# Prepare /opt/nodered-modules directory
WORKDIR /opt/nodered-modules
COPY infra/nodered/package.json /opt/nodered-modules/package.json
COPY infra/nodered/node_modules /opt/nodered-modules/node_modules

# Copy entrypoint wrapper
COPY entrypoint-nodered.sh /usr/local/bin/entrypoint-nodered.sh
RUN chmod +x /usr/local/bin/entrypoint-nodered.sh

# Ensure proper permissions for node-red user
RUN chown -R node-red:node-red /opt/nodered-modules /usr/local/bin/entrypoint-nodered.sh

USER node-red
WORKDIR /usr/src/node-red

ENTRYPOINT ["/usr/local/bin/entrypoint-nodered.sh"]
CMD ["node", "--jitless", "--max-old-space-size=512", "node_modules/node-red/red.js", "--userDir", "/data", "flows.json"]

LABEL jesa.version="2.1" jesa.node-red="4.0.9" jesa.node="20" jesa.gateway="Node-RED-only"
